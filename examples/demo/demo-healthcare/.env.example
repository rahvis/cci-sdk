# Copy to .env and fill in from claude_api.md (never commit the real file).

# Your Anthropic key. Used directly by both pipelines' agent model, and by
# the hosted CCI API server-side for the cci/ pipeline's Set/Gate/Claim
# calls (the hosted API uses its own server-side key, not this one, but
# both point at the same account for this demo).
ANTHROPIC_API_KEY=

# The model both pipelines use to draft the urgency label/explanation.
ANTHROPIC_MODEL=claude-sonnet-5

# Your CCI hosted API key, from https://cci.gitdate.ink/dashboard/keys.
# The SDK itself reads CLI_API_KEY, not CCI_API_KEY; common/env.py copies
# this value across at startup so you only need to set it once, here.
CCI_API_KEY=
