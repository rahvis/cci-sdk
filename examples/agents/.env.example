# Copy to .env (or export these in your shell) and replace the placeholders
# with your own values. None of these are needed for --provider mock.
# Never commit real keys.

# OpenAI
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini

# Azure OpenAI (the model is your deployment name)
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=YOUR_DEPLOYMENT_NAME
AZURE_OPENAI_API_VERSION=2024-10-21

# Anthropic Claude
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-sonnet-5

# Google Gemini (Developer API key)
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
GEMINI_MODEL=gemini-3.8-flash

# Self-hosted open weights on vLLM (OpenAI-compatible server)
#   vllm serve google/gemma-4-12B-it --max-logprobs 20 --generation-config vllm \
#     --enable-auto-tool-choice --tool-call-parser gemma4 --reasoning-parser gemma4 \
#     --chat-template examples/tool_chat_template_gemma4.jinja
#   (the chat template ships in the vLLM repository; larger Gemma 4 models such as
#   31B need several GPUs, see the vLLM Gemma 4 recipe)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=google/gemma-4-12B-it
VLLM_API_KEY=EMPTY

# Self-hosted open weights on SGLang (OpenAI-compatible server)
#   python -m sglang.launch_server --model-path google/gemma-4-12B-it --port 30000 \
#     --tool-call-parser gemma4 --reasoning-parser gemma4
SGLANG_BASE_URL=http://localhost:30000/v1
SGLANG_MODEL=google/gemma-4-12B-it
SGLANG_API_KEY=EMPTY
